# Copy to ~/.config/freshrss-quickshell/freshrss.env (outside this repo) and chmod 600.
#   mkdir -p ~/.config/freshrss-quickshell
#   cp secrets/freshrss.env.example ~/.config/freshrss-quickshell/freshrss.env
#   chmod 600 ~/.config/freshrss-quickshell/freshrss.env
#
# API password = FreshRSS Profile → API password (not the web login password).
FRESHRSS_BASE_URL=https://freshrss.example
FRESHRSS_USER=admin
FRESHRSS_API_PASSWORD=
