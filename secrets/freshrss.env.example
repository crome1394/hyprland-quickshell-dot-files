# Copy to freshrss.env and adjust. freshrss.env is gitignored (mode 600 recommended).
#
# Mode selection (automatic in scripts/freshrss-api.sh):
#   - If FRESHRSS_API_PASSWORD is set → full client (GReader All/Read + Fever Unread/Starred)
#   - If only BASE_URL is set          → public RSS / anonymous read (no mark-read)

FRESHRSS_BASE_URL=http://10.74.10.8
FRESHRSS_USER=admin

# Profile → "API password" (NOT the web form login password).
# Leave empty for anonymous RSS mode (works with "Allow anonymous reading").
# FRESHRSS_API_PASSWORD=
